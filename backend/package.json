{
  "name": "ai-impact-observatory-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the AI Impact Observatory MVP.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:ensure": "node scripts/ensure-dev-db.js",
    "db:setup": "npm run db:ensure && npm run prisma:migrate:deploy",
    "seed:reset": "ts-node scripts/official-seed.ts reset",
    "seed:import": "ts-node scripts/official-seed.ts import",
    "seed:reload": "ts-node scripts/official-seed.ts reload",
    "smoke:auth:local": "node scripts/smoke-auth-local.js",
    "smoke:editorial": "node scripts/smoke-editorial.js",
    "smoke:public": "node scripts/smoke-public-catalog.js",
    "smoke:admin:seed": "node scripts/smoke-admin-seed.js",
    "smoke:contributions": "node scripts/smoke-contributions.js",
    "smoke:contributions:negative": "node scripts/smoke-contributions-negative.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.10.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "brace-expansion@^1.1.7": "^1.1.21",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "@nestjs/cli": {
      "glob": "^14.0.2"
    }
  }
}
