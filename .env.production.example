COMPOSE_PROJECT_NAME=aiio-observatory

POSTGRES_DB=ai_impact_observatory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

FRONTEND_PORT=3000
BACKEND_PORT=3001

APP_BASE_URL=https://your-domain.example
API_BASE_URL=https://your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
NEXT_PUBLIC_API_BASE_URL=https://your-domain.example/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
API_INTERNAL_BASE_URL=http://backend:3001/api/v1

SESSION_COOKIE_NAME=aiio_session
SOCIAL_SIGNUP_COOKIE_NAME=aiio_social_signup
SESSION_TTL_HOURS=720
PASSWORD_RESET_TTL_MINUTES=60
AUTH_FLOW_TTL_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
DEFAULT_LOCALE=en
AUTH_COOKIE_SECURE=true
BOOTSTRAP_ADMIN_EMAIL=
TURNSTILE_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/v1/auth/google/callback
AUTH_CONFLICT_PATH=/auth/conflict
SOCIAL_SIGNUP_PATH=/auth/social/complete

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@your-domain.example

TRANSLATION_PROVIDER=mymemory
TRANSLATION_API_BASE_URL=https://api.mymemory.translated.net
TRANSLATION_CONTACT_EMAIL=

SEED_CSV_PATH=/docs/seed_portal_impacto_ia_bilingue_tres_evidencias_corregido.csv
